<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="backend.modules.profile.mapper.ProfileMapper">

    <!--
        查询 v_volunteer_profile 视图
        map-underscore-to-camel-case=true 自动处理字段映射：
          user_id          → userId
          real_name        → realName
          student_id       → studentId
          avatar_url       → avatarUrl
          total_hours      → totalHours
          activity_count   → activityCount
          type_diversity   → typeDiversity
          avg_score        → avgScore
          punctuality_rate → punctualityRate
          badge_count      → badgeCount
          skill_tags       → skillTags
    -->
    <select id="selectByUserId" resultType="backend.modules.profile.dto.ProfileVO">
        SELECT vp.user_id,
               vp.real_name,
               vp.student_id,
               vp.avatar_url,
               u.email,
               u.phone,
               vp.total_hours,
               vp.activity_count,
               vp.type_diversity,
               vp.avg_score,
               vp.punctuality_rate,
               vp.badge_count,
               vp.skill_tags
        FROM v_volunteer_profile vp
        JOIN sys_user u ON u.id = vp.user_id
        WHERE vp.user_id = #{userId}
    </select>

</mapper>
